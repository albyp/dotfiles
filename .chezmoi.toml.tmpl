{{- /* Asked once per machine; the answers live in ~/.config/chezmoi/chezmoi.toml, not in git */ -}}
{{- $name := promptStringOnce . "name" "Git name" -}}
{{- $email := promptStringOnce . "email" "Git email" -}}
sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}

[git]
    autoCommit = true
    autoPush = true
