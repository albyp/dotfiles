[user]
	name = {{ .name }}
	email = {{ .email }}
[init]
	defaultBranch = main
[core]
	editor = nvim
[pull]
	rebase = false
[push]
	autoSetupRemote = true
# GitHub logins come from `gh auth login`; no plaintext ~/.git-credentials
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
